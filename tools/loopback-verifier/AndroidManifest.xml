<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.ushareiplay.loopback">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <application android:label="UShareIPlay Loopback Verifier" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <service android:name=".MainActivity$ProjectionService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
