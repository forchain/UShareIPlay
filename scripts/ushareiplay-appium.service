[Unit]
Description=Appium Server for UShareIPlay
After=network.target

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env appium --allow-insecure=*:adb_shell,*:chromedriver_autodownload --address 0.0.0.0 --port 4723
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
